- const CNAME = 'blog.webjam.space' 
- let blogPosts = []

mixin Page(name)
  html(name=name)
    head
      title Web Jam Blog
      style.
        p {
          margin-bottom: 1rem;
        } 
    body[
      flex flex-col gap-12 p6 text-white
      bg-linear-to-b bg-no-repeat bg-purple-800 bg-size-[auto_400px] from-white/20
      lg:pb-24
    ]
      h1[
        relative my12
        font-bold font-mono text-14/28 text-center text-shadow-[0_4px_0_#000]
        sm:my24 sm:text-20/32
      ]
        a[relative z-2](href=".") Web Jam Blog
        div[
          absolute left-0 top-0 z-1 pointer-events-none w-full
          font-bold font-mono text-14/28 text-center text-shadow-[0_0_60px_#fff]
          text-transparent sm:text-20/32
        ](aria-hidden) Web Jam Blog
      block

mixin BlogPage(title, postOverview)
  - const slug = title.toLocaleLowerCase().replaceAll(/\s+/g, '-')
  - blogPosts.push([title, slug, postOverview])
  +Page(slug)
    +BlogPostHeader(title, slug, postOverview)
    block
    
mixin BlogPostHeader(title, slug, overview)
  div[
    flex flex-col gap-6 max-w-screen-lg mx-auto p6
    bg-linear-to-t bg-white/100 from-black/5 rounded-4 shadow-[0_3px_0_#000]
    md:flex-row
  ]
    // link to post or not?
   
    a[
      relative w-1/1 cursor-pointer shrink-0
      font-bold font-mono text-6/16 text-left text-shadow-[1px_2px_0_#fff] text-sky-500 underline
      group underline-2 underline-dashed underline-offset-8 underline-sky-200
      hover:(underline-sky-500 text-sky-400) md:text-center md:w-1/3
    ](href=slug)
      div[relative z-2 text-sky-400]=title
      div[
        absolute left-0 top-0 z-1 text-sky-300 blur-4 opacity-0
        duration-500 transition-opacity group-hover:(opacity-100 duration-0)
      ](aria-hidden)=title
    div[flex-ss w-1/1 grow text-5/8 text-black/77 tracking-0.5px md:flex-cs md:w-2/3]
      div[w-full]
        div[
          shrink-0 h-24 ml6 w-24
          b-5 b-white float-right overflow-hidden rounded-full shadow-[0_2px_0_#aaa,0_1px_4px_#0008,0_0_0_1px_#0002]
          sm:h-32 sm:w-32
        ]
          img[h-full w-full object-cover](src="images/tapping/sm.webp")
        div= overview
        div[mt6 text-right whitespace-nowrap]
         
          a[
            relative z-0 group
            inline-block pl0.5 pr4
            font-bold font-serif text-shadow-[0_1px_0_#0003,0_0_12px_#fff6] tracking-2px text-white
          ](href="https://ezequielschwartzman.org" target="_blank")
            span[absolute w-full h-full z-10 b b-black/20 bg-lime-500 group-hover:bg-lime-400 transition-colors bg-linear-to-b from-black/8 shadow-[0_-1px_0] shadow-lime-700 rounded-full]
            span[absolute -z-3 right-full translate-x-4px group-hover:translate-x-8px transition-transform top-1/2 -translate-y-1/2 bg-lime-50 b b-black/20 b-r-0 bg-linear-to-b from-black/4 rounded-l-full px2 py2 inline-flex items-center justify-center]
              span[block h-1 w-3 bg-lime-800 rounded-full]
            img[relative z-11 ml2px inline-block h-8 mb2px mr2 w-8 object-cover rounded-full](src="images/ezequiel/sm.webp")
            span[relative z-11] Ezequiel
        
